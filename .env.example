# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram Bot Config
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Секретный токен для проверки подлинности вебхука от Telegram Bot API
TELEGRAM_WEBHOOK_SECRET=gorkiy_secret_webhook_token_example

# Chat IDs for 4 locations & default fallback
TELEGRAM_CHAT_ID_ARBAT=-1001234567890
TELEGRAM_CHAT_ID_ASHUROVA=-1001234567891
TELEGRAM_CHAT_ID_KULIEVA=-1001234567892
TELEGRAM_CHAT_ID_SREDA=-1001234567893
TELEGRAM_DEFAULT_CHAT_ID=-1001234567890

# Admin secret
ADMIN_PASSWORD=gorkiy_admin_secret
